# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Where the site lives. A domain gets HTTPS automatically, e.g.
#   profrating.example.com   (an A record pointing at the server's static IP)
#   13-250-1-2.sslip.io      (free: replace with your static IP, dots -> dashes)
# Leave as :80 to try it without HTTPS (login cookie needs COOKIE_SECURE=false then)
SITE_ADDRESS=:80

# Database password. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Signs login codes. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a new one for production, not the one from your laptop
SECRET_KEY=
ALLOWED_EMAIL_DOMAINS=u.nus.edu
# true once SITE_ADDRESS is a domain (HTTPS)
COOKIE_SECURE=true

# smtp = send real login emails
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
