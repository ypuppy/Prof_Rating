# Matches docker-compose.yml. Copy to .env and change for production.
DATABASE_URL=postgresql+psycopg://profrating:profrating@localhost:5432/profrating

# Only needed when running scripts/migrate_from_mongo.py
MONGODB_URI=
MONGODB_DB=nus_prof_rater

# Signs login codes. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Comma-separated; only these email domains can log in
ALLOWED_EMAIL_DOMAINS=u.nus.edu
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# console = print login codes in the server terminal; smtp = send real email
EMAIL_BACKEND=console
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
